  "components" : {
    "schemas" : {
      "CedarError" : {
        "type" : "object",
        "additionalProperties" : false,
        "description" : "A CEDAR error response. Diagnostic fields are populated only when they are relevant to the failure.",
        "properties" : {
          "entities" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "object",
              "description" : "Named domain entities associated with exception-mapped errors.",
              "nullable" : true
            },
            "description" : "Named domain entities associated with exception-mapped errors.",
            "nullable" : true
          },
          "errorId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Correlation identifier for an internal error recorded in server logs.",
            "nullable" : true
          },
          "errorKey" : {
            "type" : "string",
            "description" : "Stable machine-readable error identifier.",
            "enum" : [ "templateElementNotCreated", "templateElementNotFound", "templateElementNotDeleted", "templateElementNotUpdated", "templateElementsNotListed", "templateFieldNotCreated", "templateFieldNotFound", "templateFieldNotDeleted", "templateFieldNotUpdated", "templateFieldsNotListed", "templateNotCreated", "templateNotFound", "templateNotDeleted", "templateNotUpdated", "templatesNotListed", "templateInstanceNotCreated", "templateInstanceNotFound", "templateInstanceNotDeleted", "templateInstanceNotUpdated", "templateInstancesNotListed", "noReadAccessToResource", "noWriteAccessToResource", "noReadAccessToFolder", "noWriteAccessToFolder", "noReadAccessToTemplate", "noWriteAccessToTemplate", "noReadAccessToTemplateElement", "noWriteAccessToTemplateElement", "noReadAccessToTemplateField", "noWriteAccessToTemplateField", "noReadAccessToTemplateInstance", "noWriteAccessToTemplateInstance", "noReadAccessToArtifact", "noWriteAccessToArtifact", "noReadAccessToCategory", "noWriteAccessToCategory", "folderNotFound", "artifactNotFound", "artifactPreconditionRequired", "artifactHasMovedOn", "verbatimWriteRefused", "nodeNotFound", "unknownResourceType", "missingParameter", "invalidInput", "sourceFolderNotFound", "sourceResourceNotFound", "targetFolderNotFound", "nodeNotMoved", "groupNotFound", "userNotFound", "uniqueConstraintCollision", "invalidData", "notAuthorized", "permissionMissing", "tokenInvalid", "userInfoLoadByTokenFailed", "userInfoLoadByApiKeyFailed", "cedarUserNotFound", "authorizationNotFound", "permissionNotOwned", "authorizationTypeUnknown", "apiKeyNotFound", "tokenMissing", "tokenExpired", "parentFolderNotSpecified", "parentFolderSpecifiedTwice", "pathNotNormalized", "parentFolderNotFound", "updateInvalidFolderName", "createInvalidFolderName", "nodeAlreadyPresent", "folderNotCreated", "missingNameAndDescription", "missingData", "folderNotDeleted", "artifactNotDeleted", "resourceNotCreated", "invalidResourceType", "invalidArtifactType", "readOtherProfileForbidden", "updateOtherProfileForbidden", "folderCanNotBeDeleted", "folderCanNotBeChanged", "groupAlreadyPresent", "groupCanBeModifiedOnlyByGroupAdmin", "groupCanBeDeletedOnlyByGroupAdmin", "groupMembersCanBeReadOnlyByGroupAdmin", "groupRequiresAdministrator", "groupUsersNotUpdated", "specialGroupCanNotBeDeleted", "folderPermissionsCanNotBeChanged", "unknownInstanceOutputFormat", "folderCopyNotAllowed", "methodNotImplemented", "upstreamServerError", "nothingToDo", "parentCategoryNotFound", "categoryAlreadyPresent", "categoryNotFound", "categoryCanNotBeDeleted", "rootCategoryCanNotBeDeleted", "unableToAttachCategory", "unableToDetachCategory", "noCategoriesWereAttached", "malformedJsonRequestBody", "malformedSearchTerm", "publishedArtifactCanNotBeChanged", "publishedArtifactCanNotBeDeleted", "versioningOnlyOnLatest", "versioningOnlyByOwner", "nonVersionedArtifactType", "createDraftOnlyFromPublished", "publishOnlyDraft", "draftNotCreated", "contentNotValid", "doiNotSupportedByResourceType", "doiCanNotBeSetForEmptyAtId", "doiCanNotBeAltered", "doiCanNotBeSet", "doiAlreadyExists", "dataCiteDOIDisabled", "pinnedVersionUnavailable", "resourceNotFound", "rateLimitExceeded", "rateLimitUnavailable", "internalError" ],
            "nullable" : true
          },
          "errorReasonKey" : {
            "type" : "string",
            "description" : "More specific machine-readable reason for the error.",
            "enum" : [ "nonEmptyFolder", "nonEmptyCategory", "userHomeFolder", "systemFolder", "templateReferencedInInstances", "validationError", "continuationExpired" ],
            "nullable" : true
          },
          "errorType" : {
            "type" : "string",
            "description" : "Broad category of the error.",
            "enum" : [ "notFound", "invalidArgument", "authorization", "permission", "server", "validationError" ],
            "nullable" : true
          },
          "message" : {
            "type" : "string",
            "description" : "Human-readable error message.",
            "nullable" : true
          },
          "objects" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "object",
              "description" : "Named structured values associated with the error."
            },
            "description" : "Named structured values associated with the error."
          },
          "operation" : {
            "type" : "object",
            "description" : "Operation that failed. Its fields depend on the operation type.",
            "nullable" : true
          },
          "parameters" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "object",
              "description" : "Named scalar values associated with the error."
            },
            "description" : "Named scalar values associated with the error."
          },
          "status" : {
            "type" : "string",
            "description" : "Symbolic HTTP response status, or HTTP_<code> for an unnamed status.",
            "pattern" : "^[A-Z][A-Z0-9_]*$"
          },
          "statusCode" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Numeric HTTP response status.",
            "maximum" : 599,
            "minimum" : 400
          },
          "suggestedAction" : {
            "type" : "string",
            "description" : "Recovery action suggested to the client.",
            "enum" : [ "none", "requestRole", "logout", "logoutImmediately", "provideAuthorizationHeader", "refreshToken" ],
            "nullable" : true
          }
        },
        "required" : [ "status", "statusCode" ]
      },
      "IndexingProgress" : {
        "type" : "object",
        "additionalProperties" : false,
        "description" : "How far a rebuild has got. Each phase carries its own counter, because what is being counted\nchanges with it: pages of resources while enumerating, resources while indexing, nothing at\nall while promoting. `total` is -1 until the phase's denominator is known, and the rate and\nestimate are absent until enough has been done to measure them.\n",
        "properties" : {
          "estimatedFinishAt" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          },
          "lastUpdatedAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "When the job last reported anything. This is what tells a slow rebuild from a stopped one,\nand it is what the overdue deadline is measured from.\n"
          },
          "percentComplete" : {
            "type" : "number",
            "format" : "double",
            "nullable" : true
          },
          "phase" : {
            "type" : "string",
            "enum" : [ "PENDING", "LOADING_VALUE_SETS", "ENUMERATING", "COMPARING", "INDEXING", "VERIFYING", "PROMOTING", "DONE" ]
          },
          "phaseDescription" : {
            "type" : "string",
            "description" : "The phase in words, so a client need not keep its own table of these names."
          },
          "processed" : {
            "type" : "integer",
            "format" : "int64"
          },
          "processedByType" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int64"
            },
            "description" : "How many of each kind have been done."
          },
          "secondsRemaining" : {
            "type" : "integer",
            "format" : "int64",
            "nullable" : true
          },
          "startedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "total" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "The current phase's denominator, or -1 while it is not yet known."
          },
          "totalByType" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int64"
            },
            "description" : "How many resources of each kind the work list holds."
          },
          "unitsPerSecond" : {
            "type" : "number",
            "format" : "double",
            "description" : "The rate over a trailing window rather than the whole run, absent until measurable. Null\nand zero are different answers: only the second means no progress.\n",
            "nullable" : true
          }
        },
        "required" : [ "phase", "processed", "total" ]
      },
      "JobStatus" : {
        "type" : "object",
        "additionalProperties" : false,
        "description" : "One job, in the shape every CEDAR server that runs jobs reports it in. `deadlineAt` and\n`overdue` describe a running job and are empty otherwise. The properties after `failure`\nbelong to one kind of job each and are absent for the others.\n",
        "properties" : {
          "command" : {
            "type" : "string",
            "description" : "The command that started the job.",
            "nullable" : true
          },
          "deadlineAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "When a running job that reports nothing more will be believed to have stopped.",
            "nullable" : true
          },
          "failure" : {
            "type" : "string",
            "description" : "What went wrong, when the state is FAILED, ABANDONED or INTERRUPTED.",
            "nullable" : true
          },
          "finishedAt" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          },
          "importStatus" : {
            "type" : "string",
            "description" : "A value sets import's state under the name the caDSR ingestor reads.",
            "enum" : [ "NOT_YET_INITIATED", "IN_PROGRESS", "COMPLETE", "ERROR" ]
          },
          "jobId" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "search-index", "value-sets-import", "inclusion-subgraph" ]
          },
          "overdue" : {
            "type" : "boolean"
          },
          "progress" : {
            "allOf" : [ {
              "$ref" : "#/components/schemas/IndexingProgress"
            } ],
            "description" : "How far a search index rebuild got."
          },
          "startedAt" : {
            "type" : "string",
            "format" : "date-time",
            "nullable" : true
          },
          "state" : {
            "type" : "string",
            "description" : "ABANDONED is a job whose claim was reset with `POST /jobs/{id}/reset`, which may still be\nrunning. INTERRUPTED is a job the server did not survive.\n",
            "enum" : [ "QUEUED", "RUNNING", "COMPLETE", "FAILED", "ABANDONED", "INTERRUPTED" ]
          },
          "submittedAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "When an inclusion-subgraph regeneration was asked for."
          },
          "unreadableArtifacts" : {
            "type" : "array",
            "description" : "The artifacts a completed inclusion-subgraph regeneration left as they were because the\nartifact server answered something other than 200 for them. Their inclusion arcs were\nneither refreshed nor removed. Empty when every artifact was read; null until the job\ncompletes.\n",
            "items" : {
              "type" : "string"
            },
            "nullable" : true
          }
        },
        "required" : [ "jobId", "kind", "overdue", "state" ]
      }
    },
    "securitySchemes" : {
      "api_key" : {
        "description" : "Your CEDAR API key, using the format 'apiKey <yourApiKey>'",
        "in" : "header",
        "name" : "Authorization",
        "type" : "apiKey"
      }
    }
  }
}
{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "Better Metadata - Better Science\n\nThe worker server runs the background jobs the rest of CEDAR cannot do inside a request: work\nthat takes longer than a caller should wait, and that must survive being interrupted.\n\nIts endpoints start a job and report on one. They are restricted to administrators.\n",
    "title" : "CEDAR Worker Server API",
    "version" : "2.9.38-SNAPSHOT"
  },
  "paths" : {
    "/" : {
      "get" : {
        "operationId" : "showInfo",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object"
                }
              }
            },
            "description" : "The service name and links to its API documentation"
          }
        },
        "summary" : "Describe this CEDAR service",
        "tags" : [ "Service" ]
      }
    },
    "/command/regenerate-inclusion-subgraph" : {
      "post" : {
        "description" : "Ask for the graph of which artifacts include which to be rebuilt, and return the job that will do it. The work is asynchronous, so this answers immediately with a job to poll rather than waiting for the rebuild. Only one job runs at a time: asking again while one is in flight returns that job rather than starting a second. Restricted to administrators.",
        "operationId" : "regenerateInclusionSubgraph",
        "responses" : {
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobStatus"
                }
              }
            },
            "description" : "A job was started",
            "headers" : {
              "Location" : {
                "description" : "Where to poll this job's status.",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The request carries no valid credentials"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The caller is not an administrator"
          },
          "406" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The request does not accept a JSON response"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "A regeneration is already queued or running, so no second one was started. The body's objects.job holds that job.",
            "headers" : {
              "Location" : {
                "description" : "Where to poll the running job's status.",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The deployment limits each user's request rate, and the caller exceeded it"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Internal server error"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The graph database or another service the request depends on is unavailable"
          }
        },
        "security" : [ {
          "api_key" : [ ]
        } ],
        "summary" : "Start regenerating the inclusion subgraph",
        "tags" : [ "Inclusion subgraph" ]
      }
    },
